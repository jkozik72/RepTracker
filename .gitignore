# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets
.env

# Claude Code worktrees
.claude/worktrees/

# Large experiment inputs and outputs (commit small samples; link the rest)
experiments/*/data/
experiments/*/out/

# Language-specific entries: add once tooling is decided (Q2 in docs/open-questions.md)

# Python (src/website is Flask)
__pycache__/
*.pyc
.venv/

# Generated prompt bundles and AI results (regenerate in dev mode)
src/website/data/*/reptiles/*/prompts/
src/website/data/*/reptiles/*/analyses.json

# Main-mode data is the keeper's own (uploads, lizards); only toy-mode samples are committed
src/website/data/main/

# Videos uploaded into Toy mode stay local (large, and often not ours to publish);
# only the generated samples from tools/make_samples.py are committed
src/website/data/toy/media/videos/*
!src/website/data/toy/media/videos/gecko-top.mp4
!src/website/data/toy/media/videos/skink-side.mp4
!src/website/data/toy/media/videos/short-clip-top.mp4

# Which AI provider this computer uses (chosen in Settings)
src/website/data/ai-settings.json

# The Anthropic API key saved in Settings (Claude provider). Never commit it.
src/website/data/claude-key.json
# Which Claude model this computer uses (chosen in Settings)
src/website/data/claude-settings.json

# Species reference photos (Wikimedia Commons), downloaded again when a profile is created
src/website/research/*/images/

# Sign-in: the account (password hash), the cookie signing key, and the LAN certificate
src/website/data/auth.json
src/website/data/secret_key
src/website/data/tls/
