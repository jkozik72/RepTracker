# RepTracker, installed by src/pi/install.sh. Settings: /etc/reptracker.env
[Unit]
Description=RepTracker
After=network-online.target
Wants=network-online.target

[Service]
User=reptracker
Group=reptracker
# The camera devices (/dev/video*, /dev/media*, /dev/dma_heap) belong to group video
SupplementaryGroups=video
EnvironmentFile=/etc/reptracker.env
# Print lines reach the journal at once
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/reptracker/app/src/website
ExecStart=/opt/reptracker/venv/bin/python app.py --lan --port ${REPTRACKER_PORT} --http-redirect ${REPTRACKER_HTTP_REDIRECT}
# Ports below 1024 (443, 80) without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
